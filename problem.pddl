(define (problem luz)
	(:domain lightsout_rgb)
	(:objects l0 l1 l2 - line  c0 c1 c2 - column)
	(:init
		(is_off l0 c0)
		(is_default l0 c0)
		(is_red l0 c1)
		(is_default l0 c1)
		(is_blue l0 c2)
		(is_default l0 c2)
		(is_red l1 c0)
		(is_default l1 c0)
		(is_red l1 c1)
		(is_default l1 c1)
		(is_blue l1 c2)
		(is_default l1 c2)
		(is_off l2 c0)
		(is_default l2 c0)
		(is_red l2 c1)
		(is_default l2 c1)
		(is_blue l2 c2)
		(is_default l2 c2)
	)
	(:goal (forall (?l - line)
		(forall (?c - column) (is_off ?l ?c)))
)
