		(is_green l0 c0)
		(is_default l0 c0)
		(is_red l0 c1)
		(is_default l0 c1)
		(is_green l0 c2)
		(is_default l0 c2)
		(is_green l1 c0)
		(is_default l1 c0)
		(is_blue l1 c1)
		(is_default l1 c1)
		(is_green l1 c2)
		(is_default l1 c2)
	)
	(:goal (and 
 		(is_off l0 c0)
		(is_off l0 c1)
		(is_off l0 c2)
		(is_off l1 c0)
		(is_off l1 c1)
		(is_off l1 c2)
)))
