(define (problem lightsout)
    (:domain lightsout_rgb)
    (:objects l1 l2 l3 - line c1 c2 c3 - column)
    (:init
        ; COLORS
        (is_red l1 c1)
		(is_red l1 c2)
		(is_red l1 c3)
        (is_red l2 c1)
      	(is_red l2 c2)
		(is_red l2 c3)
        (is_red l3 c1)
        (is_red l3 c2)
		(is_off l3 c3)
        ; BUTTON TYPE
        (is_default l1 c1) 
        (is_default l1 c2) 
        (is_default l1 c3) 
        (is_default l2 c1) 
        (is_default l2 c2)
		(is_default l2 c3)
		(is_default l3 c1)
        (is_default l3 c2)
		(is_default l3 c3)
        ; MATRIX CONNECTION
        (next_h c1 c2)
        (next_h c2 c3)
        (next_v l1 l2)
       	(next_v l2 l3)
    )

    (:goal
        (and
			(is_off l1 c1)
			(is_off l1 c1)
			(is_off l1 c1)
			(is_off l2 c2)
			(is_off l2 c3)
			(is_off l2 c2)
			(is_off l3 c3)
			(is_off l3 c2)
			(is_off l3 c3)
        )
    )
)
